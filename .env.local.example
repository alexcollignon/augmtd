
# Resend (workflow email notifications)
RESEND_API_KEY=re_your_api_key

# Google Picker API (for Drive file selection)
# API Key: Cloud Console → Credentials → API Key (with Google Picker API enabled)
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your_google_api_key
# App ID: Cloud Console → project settings → Project number (numeric, e.g. 123456789012)
# Required for drive.file scope to authorize selected files server-side
NEXT_PUBLIC_GOOGLE_APP_ID=your_numeric_project_number

# Attendee.dev (Meeting Transcription)
ATTENDEE_API_KEY=ZJm8fk5LLmXujqDS3VGgTfs6ox5n74VW

# OpenAI API (for AI-powered action item extraction)
OPENAI_API_KEY=your_openai_api_key

# Cron Job Security (generate a random secret)
CRON_SECRET=your_random_secret_for_cron_endpoints

# Portal Base / IMPIC (Portuguese public procurement API)
# Request access at https://www.base.gov.pt/APIBase2
PORTAL_BASE_TOKEN=your_portal_base_token

