# ─── AgentOS service config ───────────────────────────────────────────────────
AGENTOS_PORT=8001

# Session storage. Leave unset locally to use SQLite (/tmp/agentos.db).
# In production point at Supabase Postgres (use the direct/session connection
# string, not the pooler, for schema migrations on first boot).
# AGENTOS_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ─── Private model providers (same env var names as the Next.js app) ───────────
# AWS Bedrock — interactive/user-facing tasks (Claude, EU region).
AWS_BEDROCK_REGION=eu-central-1
AWS_BEDROCK_ACCESS_KEY=
AWS_BEDROCK_SECRET_KEY=

# Together AI — background tasks. AUGMTD_AI_KEY matches the Next.js app's var.
AUGMTD_AI_KEY=

# ─── Optional model id overrides (default to lib/ai/defaults.ts values) ─────────
# AGENTOS_BEDROCK_SONNET=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# AGENTOS_BEDROCK_HAIKU=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# AGENTOS_TOGETHER_KIMI=moonshotai/Kimi-K2.6
# AGENTOS_TOGETHER_GPT_OSS=openai/gpt-oss-120b
